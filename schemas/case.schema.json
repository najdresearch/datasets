{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Najd canonical candidate case v1",
  "type": "object",
  "required": [
    "id",
    "track",
    "language",
    "prompt",
    "expected",
    "tags",
    "provenance"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "track": {
      "type": "string",
      "minLength": 1
    },
    "language": {
      "type": "string",
      "minLength": 1
    },
    "prompt": {
      "type": "string",
      "minLength": 1
    },
    "expected": {
      "type": "object",
      "minProperties": 1
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "provenance": {
      "type": "object",
      "minProperties": 1
    }
  },
  "additionalProperties": true
}
